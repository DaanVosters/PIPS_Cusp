library(shiny); runApp('base_model.R')
runApp('base_model.R')
set.seed(123)
n  <- 150
x1 <- runif(n)   # will drive the normal control (alpha)
x2 <- runif(n)   # will drive the splitting control (beta)
# Responses drawn from Cobb's cusp distribution
response <- Vectorize(cusp::rcusp)(1, 4 * x1 - 2, 4 * x2 - 1)
example_data <- data.frame(response = response, x1 = x1, x2 = x2)
write.csv(example_data, "example_cusp_data.csv", row.names = FALSE)
head(example_data)   # quick look
getwd()              # shows the folder where the file was saved
runApp('base_model.R')
